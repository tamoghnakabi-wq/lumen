{
  "name": "lumen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lumen \u2014 a social photo network",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix web install",
    "dev": "node scripts/dev.js",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "serve": "npm run build && npm run start",
    "seed": "npm --prefix server run seed",
    "typecheck": "npm --prefix server run typecheck && npm --prefix web run typecheck",
    "test": "node scripts/smoke.js",
    "test:security": "node scripts/security-test.js",
    "test:2fa": "node scripts/security-2fa-test.js",
    "test:2fa:ui": "node scripts/security-2fa-ui-test.js",
    "test:social": "node scripts/social-test.js",
    "backup": "node scripts/backup.js",
    "tunnel": "./tunnel.sh",
    "test:calls": "node scripts/call-test.js",
    "test:calls:edge": "node scripts/call-edge-test.js",
    "test:calls:video": "node scripts/video-call-test.js",
    "test:video": "node scripts/video-test.js",
    "test:mute": "node scripts/mute-test.js",
    "test:regression": "node scripts/regression-test.js",
    "test:ui": "node scripts/ui-test.js",
    "test:ui:sweep": "node scripts/ui-sweep-test.js",
    "test:ui:flows": "node scripts/ui-flows-test.js",
    "test:features-ui": "node scripts/features-ui-test.js",
    "test:post-overlay": "node scripts/post-overlay-test.js",
    "test:post-layout": "node scripts/post-layout-test.js"
  }
}
