# Lumen configuration. Every value has a working default; copy this to
# server/.env only if you need to change something, or export the variables in
# the shell that starts the server.
#
# For a public launch, read the "Before you launch" checklist in README.md.

# ---------------------------------------------------------------- runtime
# Set this for a real deployment. It turns on Secure cookies, HSTS, JSON logs,
# and binds the server to loopback so cloudflared is the only way in.
NODE_ENV=production

PORT=4310

# Bind address. Defaults to 127.0.0.1 under NODE_ENV=production, which is what
# makes X-Forwarded-For trustworthy: only the local tunnel can reach the port.
# Change this only if you put a different reverse proxy in front, and then set
# TRUST_PROXY to match.
# HOST=127.0.0.1

# Whose X-Forwarded-For to believe: "loopback" (default), "false", a hop count
# such as "1", or an IP/CIDR list. Never "true" on a public deployment — it lets
# any client claim any IP and walk past the rate limits.
# TRUST_PROXY=loopback

# Where the database and uploaded images live.
# DATA_DIR=./data

# ------------------------------------------------------------------ email
# Password resets are only deliverable with a mail transport. Without one the
# link is written to the server log and an operator has to relay it by hand.
# Any nodemailer-compatible URL works.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Lumen <no-reply@yourdomain.com>

# Fixes the origin used in reset links. Leave unset to derive it from the
# request, which is what you want with a rotating TryCloudflare hostname.
# PUBLIC_ORIGIN=https://lumen.yourdomain.com

# --------------------------------------------------------------- sessions
# SESSION_TTL_DAYS=30       # absolute lifetime of a session
# SESSION_IDLE_DAYS=14      # unused sessions expire sooner than that
# RESET_TTL_MINUTES=30      # password reset link lifetime

# ----------------------------------------------------------------- uploads
# MAX_UPLOAD_MB=12
# MAX_POST_IMAGES=6
# MAX_IMAGE_MEGAPIXELS=40   # refuses decompression bombs before decoding
# MAX_CONCURRENT_UPLOADS=4  # simultaneous image pipelines

# ------------------------------------------------------------------ video
# Video needs ffmpeg. The bundled ffmpeg-static is used when present, otherwise
# whatever `ffmpeg` is on PATH; with neither, uploads stay photo-only and the
# server says so at boot. Every clip is re-encoded to H.264/AAC MP4 with a
# faststart header, so these limits apply to the source file, not the output.
# MAX_VIDEO_MB=150
# MAX_VIDEO_SECONDS=90
# VIDEO_MAX_EDGE=1280               # longest side of the encoded video
# VIDEO_MAX_FPS=30
# VIDEO_MAX_BITRATE_KBPS=2500
# VIDEO_CRF=26                      # lower is better quality and bigger files
# VIDEO_CONCURRENCY=1               # transcodes at once; raise only with cores to spare
# VIDEO_TRANSCODE_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------- 2FA
# Two-factor uses TOTP (RFC 6238) with no configuration: the secret lives with
# the account and the issuer shown in authenticator apps is "Lumen". Nothing to
# set here — the entry exists so it is clear there is no hidden switch.

# ------------------------------------------------------------ audio calls
# Calls are peer-to-peer WebRTC, so no media server is involved. STUN is enough
# for most networks and the defaults are public Google servers.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#
# A TURN relay is only needed when BOTH peers are behind symmetric NAT, where
# no direct path exists. Without one those calls fail to connect; with one they
# relay through it (and it carries the audio, so size it accordingly).
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=lumen
# TURN_CREDENTIAL=change-me

# ----------------------------------------------------------------- logging
# LOG_LEVEL=info            # debug | info | warn | error

# ------------------------------------------------------------ development
# Turns off rate limiting so the functional test suite can run. Ignored when
# NODE_ENV=production.
# DISABLE_RATE_LIMITS=1
